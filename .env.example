# ─── Server ──────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
# Async workers: min(cpu_count, 4) is the right starting point. The usual
# cpu*2+1 formula is for SYNCHRONOUS workers and is wrong here -- more
# workers means more fragmented payload caches and a lower hit rate.
WORKERS=4
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── Auth (REQUIRED) ─────────────────────────────────────────────────────
# Generate with: python scripts/gen_token.py
API_KEY=
API_KEY_HEADER=X-API-Key

# ─── OpenCTI (REQUIRED) ──────────────────────────────────────────────────
OPENCTI_URL=https://opencti.example.com
OPENCTI_TOKEN=
OPENCTI_VERIFY_TLS=true
OPENCTI_TIMEOUT_CONNECT_MS=1000
OPENCTI_TIMEOUT_READ_MS=1500
OPENCTI_MAX_CONNECTIONS=50
OPENCTI_MAX_CONCURRENCY=20

# ─── Membership mirror (answers ~99% of traffic) ─────────────────────────
# auto  = mirror when the corpus fits the memory budget, else proxy only
# always = mirror regardless (may be truncated to the budget)
# off   = pure query-on-demand proxy
MEMBERSHIP_MODE=auto
# observables = read values directly, ~3,500/sec (17.7k in 5s, 1M in ~5min)
# indicators  = walk indicator->observable, ~210/sec, exact but ~17x slower
# The fast path's false positives self-correct via the payload query, so it is
# the default. Switch only if observables greatly outnumber indicators.
MEMBERSHIP_SOURCE=observables
MEMBERSHIP_BOOTSTRAP_PAGE_SIZE=2000
MEMBERSHIP_SNAPSHOT_INTERVAL_S=300
MEMBERSHIP_STALE_AFTER_S=900
# Full rebuild interval. Catches drift the stream cannot see: missed events,
# a gap longer than stream retention, or bulk changes made in OpenCTI directly.
# The old segment serves throughout; only the builder reconciles.
MEMBERSHIP_RECONCILE_INTERVAL_S=86400
MEMBERSHIP_OVERLAY_MAX=50000

# Cross-worker sharing: one worker bootstraps and publishes the segment name,
# the rest attach. Without it every uvicorn worker builds its own copy -- N
# bootstraps against OpenCTI and N copies of the segment.
MEMBERSHIP_SHARED=true
# Where the lock and state file live. Empty -> /dev/shm, or the temp dir on
# platforms without it.
MEMBERSHIP_STATE_DIR=
# Must exceed bootstrap time, or losing workers give up and serve via the
# live backend until the background retry picks the segment up.
MEMBERSHIP_ATTACH_TIMEOUT_S=300
# How often a non-builder re-checks for a newly published generation.
MEMBERSHIP_ATTACH_RETRY_S=30

# SSE live stream. Keeps the membership set current between rebuilds; without
# it the set is a boot-time snapshot and new intel is invisible until a
# rebuild. Each worker runs its own consumer -- the overlay it writes into is
# per-process state, not part of the shared mapping.
STREAM_ENABLED=true

# ─── Memory budget ───────────────────────────────────────────────────────
# "auto" reads the CGROUP limit first, not host RAM. Under Docker those
# differ and only the cgroup one avoids the OOM killer.
MIRROR_MAX_MEMORY_MB=auto
PAYLOAD_CACHE_MAX_MB=auto
MEMORY_FRACTION=0.5
MEMORY_RESERVE_MB=512
# Truncation ceiling per cached payload. This is what makes the LRU maxsize
# a real byte guarantee -- TTLCache counts entries, not bytes.
PAYLOAD_MAX_ENTRY_BYTES=1024
PAYLOAD_TTL_S=86400
PAYLOAD_TTL_DEGRADED_S=900

# ─── Hit semantics ───────────────────────────────────────────────────────
# Measured on OpenCTI 7.26: `revoked` is set AUTOMATICALLY when valid_until
# passes, so revoked and expired are the same set unless a human retracted
# something. live_only is the only policy that excludes anything on a corpus
# without manual revocations.
#   live_only     only revoked=false
#   expiry_aware  everything except human retractions (expired still hits, flagged)
#   all           every indicator; the pipeline rule filters
HIT_POLICY=expiry_aware
MIN_SCORE=0
URL_HOSTNAME_FALLBACK=true
# Domains are stored under BOTH types in OpenCTI. Measured: Domain-Name
# 8,124 / Hostname 2,867 -- querying only Domain-Name drops ~26% of domains.
DOMAIN_MATCH_TYPES=Domain-Name,Hostname

# ─── Resilience ──────────────────────────────────────────────────────────
REQUEST_BUDGET_MS=2000
BREAKER_FAIL_THRESHOLD=5
BREAKER_RESET_S=30

# ─── Redis (optional; the service works fully without it) ────────────────
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
REDIS_TIMEOUT_MS=50
CACHE_KEY_VERSION=v1

# ─── Skip lists (never cached, never queried) ────────────────────────────
SKIP_PRIVATE_IPS=true
SKIP_TLDS=local,internal,lan,corp,home,arpa
